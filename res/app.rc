// ============================================================================
//  app.rc —— Dream Minecraft Launcher 资源脚本
//  ---------------------------------------------------------------------------
//  编译： windres res/app.rc -O coff -o build/app.res.o
//  注意： .rc 内的路径（含 #include）都相对本文件所在目录 res/ 解析
// ============================================================================

#include "../src/resource.h"

// 应用图标：同时供窗口、任务栏与资源管理器使用
IDI_APPICON  ICON    "../assets/logo/dml.ico"

// 页眉标志：原样嵌入 PNG，运行时由 GDI+ 解码绘制
IDR_LOGO     RCDATA  "../assets/logo/dml-logo-256.png"
