// ============================================================================
//  app.rc —— Dream Minecraft Launcher 资源脚本
//  ---------------------------------------------------------------------------
//  编译： windres res/app.rc -O coff -o build/app.res.o
//  注意： .rc 内的路径（含 #include）都相对本文件所在目录 res/ 解析
// ============================================================================

#include "../src/resource.h"
#include <winver.h>

// 应用图标：同时供窗口、任务栏与资源管理器使用
IDI_APPICON  ICON    "../assets/logo/dml.ico"

// 页眉标志：原样嵌入 PNG，运行时由 GDI+ 解码绘制
IDR_LOGO     RCDATA  "../assets/logo/dml-logo-256.png"

// ---------------------------------------------------------------------------
//  版本信息：让 exe 在「属性 → 详细信息」里能看出对应哪个 Release
//  发版时只需改这里的 FILEVERSION / PRODUCTVERSION 与两个字符串
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"                       // 简体中文 + Unicode(1200)
        BEGIN
            VALUE "CompanyName",      "Dadi"
            VALUE "FileDescription",  "Dream Minecraft Launcher"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "DML"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Dadi"
            VALUE "OriginalFilename", "DML.exe"
            VALUE "ProductName",      "Dream Minecraft Launcher"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

